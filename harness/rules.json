  "gates": {
    "G01": {
      "target": "research/",
      "condition": "nonempty sources and content; all sources resolve; scope classified; supplementary rationale recorded",
      "rollback": "research"
    },
    "G02": {
      "target": "plan.md",
      "condition": "all required fields; slide count and unique sequence match; included content covered; excluded content absent",
      "rollback": "plan"
    },
    "G03": {
      "target": "approvals.json",
      "condition": "human evidence bound to unit and semantic plan hash; simulation forbidden in production",
      "rollback": "plan"
    },
    "G04": {
      "target": "assets/manifest.json",
      "condition": "all planned assets present, hashed, sourced, reviewed; no unused or missing planned IDs",
      "rollback": "image"
    },
    "G05": {
      "target": "drafts/",
      "condition": "valid PPTX and DOCX; slide/script counts match; nonempty notes and Source: per slide",
      "rollback": "production"
    },
    "G06": {
      "target": "checks/reviews.json and figma/mapping.json",
      "condition": "all slides rendered and reviewed in every category; no open issues; current hashes; one unique Figma node per slide",
      "rollback": "cause"
    },
    "G07": {
      "target": "protected baseline",
      "condition": "original paths and file hashes unchanged; trusted baseline required",
      "rollback": "stop"
    },
    "G08": {
      "target": "design-review/reference-lock.json and review.json",
      "condition": "all seven reference-bound layouts, current artifacts and real visual comparison evidence; no unverified criteria",
      "rollback": "prototype"
    },
    "G09": {
      "target": "design-review/approvals.json and feedback.json",
      "condition": "current seven-type reference/candidate human confirmation; no unresolved feedback",
      "rollback": "prototype"
    },
    "G10": {
      "target": "checks/equations.json",
      "condition": "current PPTX and every slide inventoried; generated transparent textbook-serif equation images; white ink on black; source/science/typography reviews; actual glyph size within 5%; no stretched images or native calculation text",
      "rollback": "production"
    }
  },
  "design_review": {
    "types": [
      "cover",
      "part",
      "objectives",
      "contents",
      "figure",
      "table_formula",
      "comparison"
    ],
    "criteria": [
      "title_hierarchy",
      "visual_scale",
      "spacing",
      "image_background",
      "borders",
      "layout_fidelity",
      "typography",
      "character_identity",
      "branding"
    ],
    "optional_criteria": [
