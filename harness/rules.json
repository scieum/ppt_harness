      ],
      "table_formula": [
        "title",
        "table_or_formula"
      ],
      "comparison": [
        "title",
        "panels"
      ]
    },
    "branding": {
      "tsherpa_only_first_slide": true,
      "cover_type": "cover",
      "role": "tsherpa_logo",
      "locked_properties": [
        "bbox",
        "visible_bbox",
        "asset_sha256"
      ],
      "source": "actual reference slide logo object, with visible pixels and image crop transform; no fixed 210x60 box"
    }
