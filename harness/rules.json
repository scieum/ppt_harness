      "character_identity"
    ],
    "locked_properties": [
      "kind",
      "bbox",
      "fill",
      "font_family",
      "font_size",
      "font_weight",
      "alignment",
      "character_asset_id"
    ],
    "bbox_tolerance": 0,
    "required_roles": {
      "cover": [
        "title",
        "author",
        "characters",
        "tsherpa_logo",
        "sci_eum_logo"
      ],
      "part": [
