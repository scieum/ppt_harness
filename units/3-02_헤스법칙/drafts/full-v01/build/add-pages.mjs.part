 text(s,'중간 물질 Ca(OH)₂와 양변의 물 1 mol을 소거',236,671,1450,64,38,C.green,true);line(s,233,754,1690,754,C.gray,3);eq(s,'CaO(s) + 2HCl(aq) → CaCl₂(aq) + H₂O(l)',236,776,1450,48);strip(s,'ΔH₁ = ΔH₂ + ΔH₃ = −193.5 kJ',906);finish(9,s,'앞 장의 두 단계 반응을 합한다. Ca(OH)2(aq)와 양변의 물1mol이 소거되어 직접 반응식이 남는다. 상태가 다른 물질은 소거하지 않는다.','W22 118~119 CaO 반응식①~③');
